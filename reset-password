<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Reset — Phuzzles</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:       #0e0f13;
      --surface:  #16181f;
      --surface2: #1e2029;
      --border:   rgba(255,255,255,0.07);
      --text:     #e8e9ef;
      --muted:    #7c7f94;
      --accent:   #ff6b35;
      --accent2:  #ffb347;
      --success:  #3ecf8e;
      --success-bg: rgba(62,207,142,0.08);
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      -webkit-font-smoothing: antialiased;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }

    body::after {
      content: '';
      position: fixed;
      top: -20vh;
      left: 50%;
      transform: translateX(-50%);
      width: 80vw;
      height: 60vh;
      background: radial-gradient(ellipse at center, rgba(62,207,142,0.10) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .container {
      position: relative;
      z-index: 1;
      max-width: 440px;
      width: 100%;
      padding: 40px 24px;
      text-align: center;
      animation: fadeUp 0.6s ease both;
    }

    /* Logo mark */
    .logo-mark {
      width: 72px;
      height: 72px;
      border-radius: 18px;
      overflow: hidden;
      margin: 0 auto 28px;
    }

    .logo-mark img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Success badge */
    .success-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--success);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      background: var(--success-bg);
      border: 1px solid rgba(62,207,142,0.15);
      padding: 5px 12px;
      border-radius: 20px;
      margin-bottom: 20px;
    }

    .success-badge::before {
      content: '✓';
      font-size: 11px;
      font-weight: 700;
    }

    h1 {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(1.8rem, 5vw, 2.4rem);
      letter-spacing: -0.03em;
      line-height: 1.15;
      color: var(--text);
      margin-bottom: 12px;
    }

    h1 em { font-style: italic; color: var(--success); }

    .subtitle {
      font-size: 0.95rem;
      color: var(--muted);
      line-height: 1.7;
      max-width: 320px;
      margin: 0 auto 32px;
    }

    /* Redirect status */
    .redirect-status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 0.85rem;
      color: var(--muted);
      margin-bottom: 28px;
    }

    .spinner {
      width: 14px;
      height: 14px;
      border: 2px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      flex-shrink: 0;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Fallback card */
    .fallback {
      display: none;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      margin-bottom: 0;
    }

    .fallback.visible { display: block; }

    .fallback p {
      font-size: 0.88rem;
      color: var(--muted);
      margin-bottom: 16px;
    }

    .open-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 13px 20px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      border-radius: 11px;
      color: #fff;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.92rem;
      font-weight: 600;
      text-decoration: none;
      transition: opacity 0.2s, transform 0.15s;
      margin-bottom: 10px;
    }

    .open-btn:hover { opacity: 0.92; transform: translateY(-1px); }
    .open-btn:active { transform: translateY(0); }

    .store-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 12px 20px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 11px;
      color: var(--muted);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.88rem;
      font-weight: 500;
      text-decoration: none;
      transition: border-color 0.2s, color 0.2s;
    }

    .store-btn:hover { border-color: var(--accent); color: var(--text); }

    .back-link {
      display: block;
      margin-top: 20px;
      font-size: 0.82rem;
      color: var(--muted);
      text-decoration: none;
      transition: color 0.2s;
    }

    .back-link:hover { color: var(--text); }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>

  <script>
    window.onload = function () {
      // Password is already reset by Firebase — just redirect to app
      window.location.href = 'phuzzles://login';

      // After 2s, assume app didn't open — show fallback options
      setTimeout(function () {
        document.getElementById('redirectStatus').style.display = 'none';
        document.getElementById('fallback').classList.add('visible');
      }, 2000);
    };
  </script>
</head>
<body>
  <div class="container">

    <div class="logo-mark">
      <img src="/logo2.png" alt="Phuzzles logo" width="72" height="72" />
    </div>

    <div class="success-badge">Password updated</div>

    <h1>You're all <em>set</em></h1>
    <p class="subtitle">Your password has been reset. Taking you back to Phuzzles now…</p>

    <div class="redirect-status" id="redirectStatus">
      <div class="spinner"></div>
      Opening Phuzzles…
    </div>

    <div class="fallback" id="fallback">
      <p>The app didn't open automatically. Tap below to continue.</p>

      <!-- Try the deep link again manually -->
      <a href="phuzzles://login" class="open-btn">
        Open Phuzzles
      </a>

      <!-- If not installed, send to Play Store -->
      <a
        href="https://play.google.com/store/apps/details?id=rebelstudios.phuzzles.app"
        class="store-btn"
        target="_blank"
        rel="noopener"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3.18 23.76a2 2 0 0 0 2.84.24L17.5 12 6.02.02A2 2 0 0 0 3 2v20a2 2 0 0 0 .18 1.76zM20.5 10.5l-2.96-1.7L14.5 12l3.04 3.2 3-.17a2 2 0 0 0 0-4.03l.96-.5z"/>
        </svg>
        Download on Google Play
      </a>
    </div>

    <a class="back-link" href="/">← Back to phuzzles.app</a>

  </div>
</body>
</html>