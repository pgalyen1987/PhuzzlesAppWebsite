<!DOCTYPE html>
<html>
  <head>
    <title>Phuzzles - Password Reset</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>
      window.onload = function() {
        // Attempt to open the app
        window.location.href = "phuzzles://login";

        // If the app didn't open after 2 seconds, show the fallback button
        setTimeout(function() {
          document.getElementById("fallback").style.display = "block";
        }, 2000);
      };
    </script>
  </head>
  <body>
    <h2>Password reset successful!</h2>
    <p>Your password has been updated. Returning you to Phuzzles...</p>

    <div id="fallback" style="display:none">
      <p>Didn't open automatically?</p>
      <a href="phuzzles://login">Tap here to open Phuzzles</a>
    </div>
  </body>
</html>